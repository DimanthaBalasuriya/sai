#include "common.slang"
[[vk::binding(2,0)]] RWTexture2D<float4> outputs[8];
[[vk::binding(5,0)]] RWTexture3D<float4> volumeOutputs[8];
[[vk::binding(6,0)]] RWTexture2DArray<float4> cubeOutputs[8];
struct ComputeData{Parameters* settings;uint mode,width,height,depth;};
[[vk::push_constant]] ConstantBuffer<ComputeData> pass;
float3 CubeRay(uint face,float2 uv){float2 q=uv*2-1;float3 d;if(face==0)d=float3(1,-q.y,-q.x);else if(face==1)d=float3(-1,-q.y,q.x);else if(face==2)d=float3(q.x,1,q.y);else if(face==3)d=float3(q.x,-1,-q.y);else if(face==4)d=float3(q.x,-q.y,1);else d=float3(-q.x,-q.y,-1);return normalize(d);}
[shader("compute")][numthreads(8,8,1)]
void ComputeMain(uint3 id:SV_DispatchThreadID){
 if(id.x>=pass.width||id.y>=pass.height||id.z>=pass.depth)return;
 Parameters p=*pass.settings;float2 uv=(float2(id.xy)+.5)/float2(pass.width,pass.height);uint mode=ENGINE_SKY_COMPUTE_MODE;
 if(mode==0){outputs[0][id.xy]=float4(Transmittance(p,uv.y*p.planet.y,uv.x*2-1),1);return;}
 if(mode==1){
   // Hillaire's isotropic multi-scattering closure: integrate single scattering
   // and the fraction returned to scattering, then sum the geometric series.
   float3 origin=float3(0,p.planet.x+max(2,uv.y*p.planet.y),0),sunDir=float3(sqrt(saturate(1-pow(uv.x*2-1,2))),uv.x*2-1,0);
   float3 radiance=0,returnFraction=0;
   for(uint r=0;r<16;++r){float y=1-2*(r+.5)/16,a=r*2.39996323;float3 ray=float3(cos(a)*sqrt(1-y*y),y,sin(a)*sqrt(1-y*y));float2 top=Sphere(origin,ray,p.planet.x+p.planet.y),hit=Sphere(origin,ray,p.planet.x);float distance=hit.x>0?min(top.y,hit.x):top.y;float step=max(0,distance)/12;float3 T=1;
    for(uint i=0;i<12;++i){float3 pos=origin+ray*(i+.5)*step;float altitude=max(0,length(pos)-p.planet.x);float3 ext=Extinction(p,altitude),scatter=p.rayleigh.xyz*exp(-altitude/p.rayleigh.w)+p.mie.xyz*exp(-altitude/p.mie.w),segment=exp(-ext*step);float3 integral=T*(1-segment)/max(ext,1e-8);float3 direct=images[0].SampleLevel(samplers[0],float2(dot(normalize(pos),sunDir)*.5+.5,saturate(altitude/p.planet.y)),0).rgb;radiance+=integral*scatter*direct/(4*PI);returnFraction+=integral*scatter;T*=segment;}
    if(hit.x>0)radiance+=T*p.ground.rgb*max(0,sunDir.y)/(4*PI);
   }
   radiance/=16;returnFraction/=16;outputs[0][id.xy]=float4(radiance/max(.03,1-returnFraction),1);return;
 }
 if(mode==2){float3 ray=SkyRay(uv),origin=float3(0,p.planet.x+max(2,min(p.orbital.y,50000)),0);float2 top=Sphere(origin,ray,p.planet.x+p.planet.y),ground=Sphere(origin,ray,p.planet.x);float distance=max(0,top.y);bool hits=ground.x>0;if(hits)distance=min(distance,ground.x);float3 T;float3 color=IntegrateSky(p,origin,ray,distance,24,T);if(hits){float3 normal=normalize(origin+ray*distance);float3 sun=SunTrans(p,1,dot(normal,p.sun.xyz))*p.sunColor.rgb*p.sun.w*max(0,dot(normal,p.sun.xyz));float3 moon=SunTrans(p,1,dot(normal,p.moon.xyz))*p.moonColor.rgb*p.moon.w*max(0,dot(normal,p.moon.xyz));color+=T*p.ground.rgb*(sun+moon)/PI;}outputs[0][id.xy]=float4(color,1);return;}
 if(mode==3){float3 uvw=(float3(id)+.5)/float3(pass.width,pass.height,pass.depth);float distance=exp2(uvw.z*log2(1+p.quality.w))-1;float3 ray=ViewRay(p,uvw.xy),T;float3 scatter=IntegrateSky(p,float3(0,p.planet.x+max(2,min(p.orbital.y,50000)),0),ray,distance,8,T);float fog=exp(-p.weather.z*distance);volumeOutputs[0][id]=float4(scatter+float3(.32,.38,.45)*(1-fog)*p.sun.w*.03,dot(T,1.0/3)*fog);return;}
 if(mode==4){float3 q=(float3(id)+.5)/float3(pass.width,pass.height,pass.depth);float3 pos=q*8;float perlin=Noise(pos)*.625+Noise(pos*2)*.25+Noise(pos*4)*.125;float worley=1-Worley(pos);volumeOutputs[0][id]=float4(saturate(lerp(worley,perlin,.7)),worley,Noise(pos*4),1);return;}
 if(mode==5){float3 q=float3(uv*8,1);float n=Noise(q)*.65+Noise(q*2)*.35;float coverage=saturate(p.clouds.z+(n-.5)*.55);outputs[0][id.xy]=float4(coverage,p.weather.y,p.weather.x,1);return;}
 if(mode==6){float3 pos=float3((uv.x-.5)*40000+p.shadowOrigin.x,p.clouds.x+p.clouds.y*.5,(uv.y-.5)*40000+p.shadowOrigin.z);float sunHeight=max(.08,p.sun.y);pos.xz+=p.sun.xz*(pos.y-p.shadowOrigin.y)/sunHeight;float optical=0;for(uint i=0;i<8;++i){float h=(i+.5)/8;float3 samplePos=pos+p.sun.xyz*(h-.5)*p.clouds.y/sunHeight;optical+=CloudDensity(p,samplePos)*p.clouds.y/(8*sunHeight)*.001;}outputs[0][id.xy]=float4(lerp(1,exp(-optical),p.shadowOrigin.w),0,0,1);return;}
 if(mode==7){float3 normal=CubeRay(id.z,uv),up=abs(normal.y)<.95?float3(0,1,0):float3(1,0,0),t=normalize(cross(up,normal)),b=cross(normal,t),sum=0;for(uint i=0;i<24;++i){float a=i*2.39996323,r=sqrt((i+.5)/24),z=sqrt(1-r*r);float3 d=t*cos(a)*r+b*sin(a)*r+normal*z;sum+=images[0].SampleLevel(samplers[0],SkyUV(d),0).rgb;}sum/=24;sum=lerp(sum,sum*.32+float3(.04)*p.sun.w*.05*p.extra2.y,p.clouds.z*.65);cubeOutputs[0][id]=float4(sum,1);return;}
 if(mode==8){float3 ray=ViewRay(p,uv);float3 origin=p.cameraTime.xyz;float sceneZ=images[0].Load(int3(uint2(uv*p.quality.xy),0)).r;float sceneDistance=sceneZ>0?length(WorldAt(p,uv,sceneZ)-origin):120000;float low=(p.clouds.x-origin.y)/ray.y,high=(p.clouds.x+p.clouds.y-origin.y)/ray.y;float start=max(0,min(low,high)),end=min(sceneDistance,max(low,high));float3 color=0;float trans=1,weighted=0,weights=0;uint count=(uint)p.quality.z;if(abs(ray.y)<.00001||end<=start){outputs[0][id.xy]=float4(0,0,0,1);outputs[1][id.xy]=0;return;}end=min(end,start+80000);float step=(end-start)/count;float jitter=Hash(float3(id.xy,p.cameraTime.w));float distance=start+jitter*step;uint steps=0;while(distance<end&&trans>.015&&steps<count){float3 pos=origin+ray*distance;float density=CloudDensity(p,pos);if(density>.001){float optical=density*step*.0015;float segment=exp(-optical);float mu=dot(ray,p.sun.xyz),g=.55,phase=(1-g*g)/(4*PI*pow(max(.05,1+g*g-2*g*mu),1.5));float sunOptical=0;for(uint l=0;l<4;++l)sunOptical+=CloudDensity(p,pos+p.sun.xyz*(l+1)*p.clouds.y*.16)*p.clouds.y*.16*.0015;float powder=1-exp(-optical*2);float3 sunTrans=images[3].SampleLevel(samplers[0],float2(p.sun.y*.5+.5,saturate(pos.y/p.planet.y)),0).rgb;float3 lighting=p.sunColor.rgb*p.sun.w*sunTrans*(exp(-sunOptical)*phase+powder*.03)+float3(.025,.035,.055)*(.05+p.extra2.y*p.sun.w*.2);color+=trans*(1-segment)*lighting;weighted+=distance*trans*(1-segment);weights+=trans*(1-segment);trans*=segment;distance+=step;}else distance+=step*1.5;++steps;}outputs[0][id.xy]=float4(color,trans);outputs[1][id.xy]=float4(weights>.001?weighted/weights/120000:0,steps/(float)count,0,1);return;}
 if(mode==9||mode==10){float4 current=images[0].SampleLevel(samplers[0],uv,0);float distance=images[1].SampleLevel(samplers[0],uv,0).r*120000;float3 world=p.cameraTime.xyz+ViewRay(p,uv)*distance-p.wind.xyz*p.extra2.x;float4 previous=mul(p.previousVP,float4(world,1));float2 prevUV=previous.xy/previous.w*.5+.5;float blend=0;if(p.celestial.w>0&&distance>0&&previous.w>0&&all(prevUV>0)&&all(prevUV<1)){float4 history=images[2].SampleLevel(samplers[0],prevUV,0);float oldDistance=images[3].SampleLevel(samplers[0],prevUV,0).r*120000;if(abs(oldDistance-distance)<max(300,distance*.08)&&abs(history.a-current.a)<.25){blend=.82;float4 mn=current,mx=current;for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x){float4 neighbor=images[0].SampleLevel(samplers[0],uv+float2(x,y)/float2(pass.width,pass.height),0);mn=min(mn,neighbor);mx=max(mx,neighbor);}current=lerp(current,clamp(history,mn,mx),blend);}}outputs[0][id.xy]=current;outputs[1][id.xy]=images[1].SampleLevel(samplers[0],uv,0);return;}
}
