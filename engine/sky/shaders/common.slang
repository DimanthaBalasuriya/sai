static const float PI=3.14159265359;
struct Parameters {
    float4x4 inverseVP;float4x4 previousVP;
    float4 cameraTime,sun,moon,sunColor,moonColor;
    float4 rayleigh,mie,ozone,planet,ground;
    float4 clouds,wind,weather,stars,celestial,quality,shadowOrigin,extra,extra2,orbital;
};
[[vk::binding(0,0)]] Texture2D<float4> images[256];
[[vk::binding(1,0)]] SamplerState samplers[256];
[[vk::binding(3,0)]] Texture3D<float4> volumes[8];
[[vk::binding(4,0)]] TextureCube<float4> cubes[8];
float Hash(float3 p){p=frac(p*.1031);p+=dot(p,p.yzx+33.33);return frac((p.x+p.y)*p.z);}
float Noise(float3 p){float3 i=floor(p),f=frac(p);f=f*f*(3-2*f);return lerp(lerp(lerp(Hash(i),Hash(i+float3(1,0,0)),f.x),lerp(Hash(i+float3(0,1,0)),Hash(i+float3(1,1,0)),f.x),f.y),lerp(lerp(Hash(i+float3(0,0,1)),Hash(i+float3(1,0,1)),f.x),lerp(Hash(i+float3(0,1,1)),Hash(i+1),f.x),f.y),f.z);}
float Worley(float3 p){float3 cell=floor(p),f=frac(p);float distance=2;for(int z=-1;z<=1;++z)for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x){float3 c=float3(x,y,z),q=c+float3(Hash(cell+c),Hash(cell+c+17),Hash(cell+c+31))-f;distance=min(distance,dot(q,q));}return saturate(sqrt(distance));}
float2 SkyUV(float3 d){return float2(atan2(d.z,d.x)/(2*PI)+.5,acos(clamp(d.y,-1,1))/PI);}
float3 SkyRay(float2 uv){float a=(uv.x-.5)*2*PI,b=uv.y*PI;return float3(cos(a)*sin(b),cos(b),sin(a)*sin(b));}
float3 ViewRay(Parameters p,float2 uv){float4 w=mul(p.inverseVP,float4(uv*2-1,.00001,1));return normalize(w.xyz/w.w-p.cameraTime.xyz);}
// All lengths are meters. Factored c and perpendicular distance avoid subtracting
// nearly equal squared planetary radii at the surface and near the limb.
float2 Sphere(float3 origin,float3 ray,float radius){float b=dot(origin,ray),r=length(origin),c=(r-radius)*(r+radius);float3 perpendicular=cross(origin,ray);float d=abs(c)<radius*radius*.01?mad(b,b,-c):radius*radius-dot(perpendicular,perpendicular);if(d<0)return float2(-1,-1);float s=sqrt(d),q=-b-(b>=0?s:-s);if(abs(q)<1e-6)return float2(-b,-b);float a=q,z=c/q;return float2(min(a,z),max(a,z));}
float3 Extinction(Parameters p,float altitude){float r=exp(-max(0,altitude)/p.rayleigh.w),m=exp(-max(0,altitude)/p.mie.w),o=saturate(1-abs(altitude-p.ozone.w)/p.planet.z);return p.rayleigh.xyz*r+(p.mie.xyz+p.planet.w)*m+p.ozone.xyz*o;}
float3 Transmittance(Parameters p,float altitude,float mu){float3 o=float3(0,p.planet.x+max(1,altitude),0),d=float3(sqrt(saturate(1-mu*mu)),mu,0);float2 top=Sphere(o,d,p.planet.x+p.planet.y),ground=Sphere(o,d,p.planet.x);if(ground.x>0)return 0;float distance=max(0,top.y),step=distance/32;float3 optical=0;for(int i=0;i<32;++i)optical+=Extinction(p,length(o+d*(i+.5)*step)-p.planet.x)*step;return exp(-optical);}
float3 SunTransAt(Parameters p,float altitude,float mu,uint index){if(altitude>=p.planet.y)return 1;float horizon=-sqrt(saturate(1-pow(p.planet.x/(p.planet.x+max(1,altitude)),2)));if(mu<horizon)return 0;return images[index].SampleLevel(samplers[0],float2(mu*.5+.5,saturate(altitude/p.planet.y)),0).rgb;}
float3 SunTrans(Parameters p,float altitude,float mu){return SunTransAt(p,altitude,mu,0);}
float3 IntegrateSky(Parameters p,float3 origin,float3 direction,float distance,uint steps,out float3 T){T=1;float3 sum=0;float step=distance/steps;float cosTheta=dot(direction,p.sun.xyz),phaseR=3/(16*PI)*(1+cosTheta*cosTheta),g=p.ground.w;float phaseM=(1-g*g)/(4*PI*pow(max(.01,1+g*g-2*g*cosTheta),1.5));for(uint i=0;i<steps;++i){float3 pos=origin+direction*(i+.5)*step;float altitude=max(0,length(pos)-p.planet.x);float3 ext=Extinction(p,altitude),segment=exp(-ext*step);float3 scattering=p.rayleigh.xyz*exp(-altitude/p.rayleigh.w)*phaseR+p.mie.xyz*exp(-altitude/p.mie.w)*phaseM;float3 direct=SunTrans(p,altitude,dot(normalize(pos),p.sun.xyz))*p.sunColor.rgb*p.sun.w;float3 multi=images[1].SampleLevel(samplers[0],float2(p.sun.y*.5+.5,saturate(altitude/p.planet.y)),0).rgb*p.sunColor.rgb*p.sun.w+images[1].SampleLevel(samplers[0],float2(p.moon.y*.5+.5,saturate(altitude/p.planet.y)),0).rgb*p.moonColor.rgb*p.moon.w;float3 moonDirect=SunTrans(p,altitude,dot(normalize(pos),p.moon.xyz))*p.moonColor.rgb*p.moon.w;float moonCos=dot(direction,p.moon.xyz),moonPhaseR=3/(16*PI)*(1+moonCos*moonCos),moonPhaseM=(1-g*g)/(4*PI*pow(max(.01,1+g*g-2*g*moonCos),1.5));float3 moonScattering=p.rayleigh.xyz*exp(-altitude/p.rayleigh.w)*moonPhaseR+p.mie.xyz*exp(-altitude/p.mie.w)*moonPhaseM;sum+=T*(scattering*direct+moonScattering*moonDirect+ext*multi)*(1-segment)/max(ext,1e-8);T*=segment;}return max(0,sum);}
float3 IntegrateSkyAt(Parameters p,float3 origin,float3 direction,float distance,uint steps,out float3 T,uint transIndex,uint multiIndex){T=1;float3 sum=0;float step=distance/steps;float cosTheta=dot(direction,p.sun.xyz),phaseR=3/(16*PI)*(1+cosTheta*cosTheta),g=p.ground.w;float phaseM=(1-g*g)/(4*PI*pow(max(.01,1+g*g-2*g*cosTheta),1.5));for(uint i=0;i<steps;++i){float3 pos=origin+direction*(i+.5)*step;float altitude=max(0,length(pos)-p.planet.x);float3 ext=Extinction(p,altitude),segment=exp(-ext*step);float3 scattering=p.rayleigh.xyz*exp(-altitude/p.rayleigh.w)*phaseR+p.mie.xyz*exp(-altitude/p.mie.w)*phaseM;float3 direct=SunTransAt(p,altitude,dot(normalize(pos),p.sun.xyz),transIndex)*p.sunColor.rgb*p.sun.w;float3 multi=images[multiIndex].SampleLevel(samplers[0],float2(p.sun.y*.5+.5,saturate(altitude/p.planet.y)),0).rgb*p.sunColor.rgb*p.sun.w+images[multiIndex].SampleLevel(samplers[0],float2(p.moon.y*.5+.5,saturate(altitude/p.planet.y)),0).rgb*p.moonColor.rgb*p.moon.w;float3 moonDirect=SunTransAt(p,altitude,dot(normalize(pos),p.moon.xyz),transIndex)*p.moonColor.rgb*p.moon.w;float moonCos=dot(direction,p.moon.xyz),moonPhaseR=3/(16*PI)*(1+moonCos*moonCos),moonPhaseM=(1-g*g)/(4*PI*pow(max(.01,1+g*g-2*g*moonCos),1.5));float3 moonScattering=p.rayleigh.xyz*exp(-altitude/p.rayleigh.w)*moonPhaseR+p.mie.xyz*exp(-altitude/p.mie.w)*moonPhaseM;sum+=T*(scattering*direct+moonScattering*moonDirect+ext*multi)*(1-segment)/max(ext,1e-8);T*=segment;}return max(0,sum);}

float3 AtmosphereRay(Parameters p,float3 ray,float maximum,uint steps,uint transIndex,uint multiIndex,out float3 T){float3 origin=float3(p.cameraTime.x,p.planet.x+max(1,p.orbital.y),p.cameraTime.z);float2 top=Sphere(origin,ray,p.planet.x+p.planet.y),ground=Sphere(origin,ray,p.planet.x);T=1;if(top.y<=0)return 0;float start=max(0,top.x),end=min(top.y,maximum);if(ground.x>0)end=min(end,ground.x);if(end<=start)return 0;float3 color=IntegrateSkyAt(p,origin+ray*start,ray,end-start,steps,T,transIndex,multiIndex);if(ground.x>0&&ground.x<=maximum){float3 normal=normalize(origin+ray*ground.x);float3 sun=SunTransAt(p,1,dot(normal,p.sun.xyz),transIndex)*p.sunColor.rgb*p.sun.w*max(0,dot(normal,p.sun.xyz));float3 moon=SunTransAt(p,1,dot(normal,p.moon.xyz),transIndex)*p.moonColor.rgb*p.moon.w*max(0,dot(normal,p.moon.xyz));color+=T*p.ground.rgb*(sun+moon)/PI;}return color;}
float CloudDensity(Parameters p,float3 world){float h=(world.y-p.clouds.x)/p.clouds.y;if(h<=0||h>=1)return 0;float3 moving=world-p.wind.xyz*p.cameraTime.w;float4 shape=volumes[1].SampleLevel(samplers[0],frac(moving*p.wind.w),0);float2 curl=float2(Noise(moving*.0003),Noise(moving*.0003+41))-.5;float detail=Noise(moving*p.weather.w+float3(curl.x,0,curl.y)*2);float coverage=images[2].SampleLevel(samplers[0],frac(moving.xz/40000),0).r;float vertical=smoothstep(0,.12,h)*(1-smoothstep(lerp(.45,.82,p.weather.y),1,h));float base=saturate((shape.r-(1-coverage)) / max(.02,coverage));return saturate((base-(1-detail)*.12)*vertical)*p.clouds.w;}
float3 WorldAt(Parameters p,float2 uv,float z){float4 w=mul(p.inverseVP,float4(uv*2-1,z,1));return w.xyz/w.w;}

