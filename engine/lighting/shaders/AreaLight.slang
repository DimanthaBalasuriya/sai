LtcEntry LookupLtc(LightingFrame* f,float roughness,float nv){float2 p=float2(roughness,acos(clamp(nv,0,1))/1.57079633)*63;uint2 a=uint2(p),b=min(a+1,63);float2 t=frac(p);LtcEntry result;result.matrix=lerp(lerp(f->ltc[a.y*64+a.x].matrix,f->ltc[a.y*64+b.x].matrix,t.x),lerp(f->ltc[b.y*64+a.x].matrix,f->ltc[b.y*64+b.x].matrix,t.x),t.y);result.amplitude=lerp(lerp(f->ltc[a.y*64+a.x].amplitude,f->ltc[a.y*64+b.x].amplitude,t.x),lerp(f->ltc[b.y*64+a.x].amplitude,f->ltc[b.y*64+b.x].amplitude,t.x),t.y);return result;}
float PolygonIntegral(float3 vertices[16],uint count){float3 clipped[20];uint n=0;for(uint i=0;i<count;++i){float3 a=vertices[i],b=vertices[(i+1)%count];bool ia=a.z>0,ib=b.z>0;if(ia)clipped[n++]=a;if(ia!=ib)clipped[n++]=lerp(a,b,a.z/(a.z-b.z));}if(n<3)return 0;float sum=0;for(uint i=0;i<n;++i){float3 a=normalize(clipped[i]+float3(0,0,1e-8)),b=normalize(clipped[(i+1)%n]+float3(0,0,1e-8));float cosine=clamp(dot(a,b),-.999999,.999999);sum+=cross(a,b).z*acos(cosine)/sqrt(max(1-cosine*cosine,1e-8));}return abs(sum)/6.2831853;}
float3 EvaluateArea(LightingFrame* f,uint index,GpuLight light,float3 p,float3 n,float3 v,float3 base,float metallic,float roughness){
    if((light.flags&1)==0||dot(light.direction,p-light.position)<=0)return 0;float distanceSq=dot(light.position-p,light.position-p);float cutoff=pow(saturate(1-pow(distanceSq*light.invRangeSq,2)),2);if(cutoff<=0)return 0;
    AreaShape shape=f->areas[index];float nv=max(.0001,dot(n,v));float3 t=v-n*dot(n,v);if(dot(t,t)<1e-8)t=abs(n.y)<.99?cross(float3(0,1,0),n):cross(float3(1,0,0),n);t=normalize(t);float3 b=cross(n,t);LtcEntry entry=LookupLtc(f,roughness,nv);float4 m=entry.matrix;float3 points[16],transformed[16];uint count=light.type==3?4:16;
    for(uint i=0;i<count;++i){float2 corner;if(light.type==3){float2 corners[4]={float2(-1,-1),float2(1,-1),float2(1,1),float2(-1,1)};corner=corners[i];}else{float angle=6.2831853*float(i)/16;corner=float2(cos(angle),sin(angle));}float3 delta=light.position-p+shape.rightWidth.xyz*shape.rightWidth.w*.5*corner.x+shape.upHeight.xyz*shape.upHeight.w*.5*corner.y;float3 q=float3(dot(t,delta),dot(b,delta),dot(n,delta));points[i]=q;transformed[i]=float3(m.x*q.x+m.y*q.z,q.y,m.z*q.x+m.w*q.z);}
    float diffuse=PolygonIntegral(points,count),specular=PolygonIntegral(transformed,count)*entry.amplitude.x;float3 f0=lerp(float3(.04),base,metallic),fresnel=f0+(1-f0)*pow(1-nv,5);return light.color*cutoff*((1-fresnel)*(1-metallic)*base*diffuse+fresnel*specular);
}
